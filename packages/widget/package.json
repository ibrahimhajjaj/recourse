{
  "name": "@helpdeck/widget",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable chat widget for helpdeck. One script tag, no dependencies, shadow DOM isolated.",
  "license": "MIT",
  "author": "Ibrahim Hajjaj",
  "homepage": "https://github.com/ibrahimhajjaj/helpdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimhajjaj/helpdeck.git",
    "directory": "packages/widget"
  },
  "keywords": [
    "chat-widget",
    "support",
    "embed",
    "shadow-dom",
    "helpdeck"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/helpdeck.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/helpdeck.min.js",
  "jsdelivr": "./dist/helpdeck.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed": "./dist/helpdeck.min.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "node build.mjs --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
