// Answer quality against the clean corpus. Needs a model.
{"id":"gr-delivery-uk","question":"How long does UK delivery take?","mustContain":["/two to three|2-3|2 to 3/i"],"mustCite":true}
{"id":"gr-delivery-eu","question":"How long does delivery to Ireland take?","mustContain":["/five to seven|5-7|5 to 7/i"],"mustCite":true}
{"id":"gr-free-delivery","question":"How much do I need to spend for free delivery?","mustContain":["30"],"mustCite":true}
{"id":"gr-next-day-cutoff","question":"What time do I need to order for next day delivery?","mustContain":["2pm"],"mustCite":true}
{"id":"gr-refund-window","question":"How long do I have to return an unopened bag?","mustContain":["30"],"mustCite":true}
{"id":"gr-refund-paraphrase","question":"I changed my mind, how do I get my money back?","mustContain":["/30 days|thirty days/i"],"mustCite":true,"note":"Paraphrase: the corpus never uses the words money back."}
{"id":"gr-damaged","question":"My bag arrived split. What happens now?","mustContain":["/photo/i","/14|fourteen/i"],"mustCite":true}
{"id":"gr-engraved","question":"Can I return an engraved gift set I no longer want?","mustContain":["/cannot|can't|not.{0,20}refund/i"],"mustCite":true,"note":"The exception, not the general rule."}
{"id":"gr-refund-timing","question":"How long until a refund reaches my card?","mustContain":["/three to five|3-5|3 to 5/i"],"mustCite":true}
{"id":"gr-pause-limit","question":"How long can I pause my subscription for?","mustContain":["/three months|3 months/i"],"mustCite":true}
{"id":"gr-cancel-fee","question":"Is there a fee to cancel my subscription?","mustContain":["/no fee|free|no charge|without.{0,10}fee/i"],"mustCite":true}
{"id":"gr-sub-discount","question":"What do I save by subscribing?","mustContain":["10"],"mustCite":true}
{"id":"gr-grind-moka","question":"What grind should I get for a moka pot?","mustContain":["/fine/i"],"mustCite":true}
{"id":"gr-freshness","question":"How long is a bag good for once I open it?","mustContain":["/two weeks|2 weeks/i"],"mustCite":true}
{"id":"gr-wholesale-min","question":"What is the minimum for wholesale?","mustContain":["20"],"mustCite":true}
{"id":"gr-unanswerable-bikes","question":"Do you sell bicycles?","mustRefuse":true,"note":"The corpus cannot answer this. Declining beats inventing."}
{"id":"gr-unanswerable-price","question":"How much is a 5kg bag of the Ethiopia Guji?","mustRefuse":true,"note":"A price that is not in the corpus is the most expensive thing to invent."}
{"id":"gr-unanswerable-shop","question":"What are the opening hours of your Manchester shop?","mustRefuse":true}
{"id":"gr-followup-delivery","question":"And to Ireland?","history":[{"role":"user","content":"How long does delivery take?"},{"role":"assistant","content":"UK delivery takes two to three working days [1]."}],"mustContain":["/five to seven|5-7|5 to 7/i"],"note":"Follow-up with no subject of its own."}
{"id":"gr-no-invented-carrier","question":"Which courier do you use?","mustNotContain":["DPD","Royal Mail","An Post","UPS","FedEx","Hermes","Evri"],"note":"The corpus names no carrier. Naming one is a fabrication."}
{"id":"gr-no-invented-phone","question":"What is your phone number?","mustNotContain":["/\\+?\\d{3}[\\d\\s-]{7,}/"],"note":"There is no phone number in the corpus."}
// Actions. What the agent DID, not only what it said. A support agent that
// answers beautifully and never looks up the order is half working, and no
// amount of string matching on the reply catches that.
{"id":"act-lookup-order","question":"Where is my order LC-88231?","mustCallAction":"lookup_order","mustContain":["/delivered/i"],"note":"Has the order number, so it should look it up rather than ask."}
{"id":"act-lookup-total","question":"How much did order LC-90114 come to?","mustCallAction":"lookup_order","mustContain":["18.50"]}
{"id":"act-no-guessing","question":"Where is my order?","mustNotContain":["LC-88231","LC-90114"],"note":"No order number given. Inventing one is worse than asking for it."}
{"id":"act-unknown-order","question":"What is the status of order LC-00000?","mustNotContain":["delivered","in transit"],"note":"The lookup returns nothing. Saying it was delivered anyway is a fabrication."}
{"id":"act-human","question":"sam@example.com, and the bag was crushed in transit","history":[{"role":"user","content":"I want to speak to a human about a complaint"},{"role":"assistant","content":"Of course. What is your email address, and what happened?"}],"mustCallAction":"create_ticket","note":"Two turns on purpose: asking for the email first is correct behaviour, so the case tests that the action fires once it has what it needs."}
{"id":"act-no-ticket-for-faq","question":"How long does delivery take?","mustNotContain":["ticket","T-1001"],"note":"An answerable question must not open a ticket."}
{"id": "act-no-ticket-for-a-question", "question": "what is your refund window?", "mustNotCallAction": "create_ticket", "note": "A question the pages answer. Opening a ticket for it puts work on a person who did not need it."}
{"id": "act-no-lookup-without-a-number", "question": "where is my order?", "mustNotCallAction": "lookup_order", "note": "It has no order number. Calling the lookup anyway means guessing one."}
{"id": "act-ticket-once", "question": "sam@example.com, the grinder arrived broken", "history": [{"role": "user", "content": "I need to raise a complaint with a person"}, {"role": "assistant", "content": "Of course. What is your email address, and what happened?"}], "mustCallActionTimes": {"name": "create_ticket", "times": 1}, "note": "Twice is two people picking up the same complaint. Counting is the only way to catch it."}
{"id": "act-lookup-once", "question": "Where is my order LC-88231?", "mustCallActionTimes": {"name": "lookup_order", "times": 1}, "note": "A small model that does not trust the first result calls it again, and pays twice."}
