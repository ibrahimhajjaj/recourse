{
  "name": "@recourse-ai/store-postgres",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Postgres implementation of the recourse Store. Survives more than one instance.",
  "license": "MIT",
  "author": "Ibrahim Hajjaj",
  "homepage": "https://github.com/ibrahimhajjaj/recourse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimhajjaj/recourse.git",
    "directory": "packages/store-postgres"
  },
  "keywords": [
    "recourse",
    "postgres",
    "store",
    "support"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@recourse-ai/core": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@recourse-ai/core": "workspace:*",
    "pg": "^8.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
