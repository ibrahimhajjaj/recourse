{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recourse-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Deliberately absent, same as the worker example: `nodejs_compat`. Nothing
  // on this path touches a Node built-in, and if that ever changes the build
  // failing is the signal.

  // Both of the values this worker needs are kept out of this file, and so out
  // of git. The account id identifies an account rather than authorising
  // anything, but a public repository is a poor place to name one, and keeping
  // the pair together is easier to reason about than splitting them.
  //
  //   Deployed:  wrangler secret put CLOUDFLARE_ACCOUNT_ID
  //              wrangler secret put CLOUDFLARE_AI_TOKEN
  //   Locally:   copy .dev.vars.example to .dev.vars and fill it in
  //
  // `.dev.vars` is git-ignored. See .dev.vars.example for the shape.

  "observability": { "enabled": true }
}
