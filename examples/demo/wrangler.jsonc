{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recourse-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Deliberately absent, same as the worker example: `nodejs_compat`. Nothing
  // on this path touches a Node built-in, and if that ever changes the build
  // failing is the signal.

  "vars": {
    // The account the Workers AI calls are billed to. Not a secret: it is in
    // every dashboard URL. The token beside it is, and is set with
    // `wrangler secret put CLOUDFLARE_AI_TOKEN`.
    "CLOUDFLARE_ACCOUNT_ID": "<CLOUDFLARE_ACCOUNT_ID>"
  },

  "observability": { "enabled": true }
}
